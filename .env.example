# Copie este arquivo para .env e preencha somente se desejar usar Gemini.
USE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Configuração da busca local
MIN_SIMILARITY=0.16
TOP_K=3

# Limites locais; cotas compartilhadas entre sessões do mesmo processo
MAX_QUESTION_CHARS=4000
MAX_PROMPT_CHARS=20000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_DAY=100
